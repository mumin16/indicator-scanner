SEPARATEWINDOW=true
OUTPUTS={ Volume={DRAW_HISTOGRAM,"colorbuffer",SHIFT_NONE}}
DESCRIPTION="Volume"

function calc()
  Volume =  VOLUME
  colorbuffer = {}
  colorbuffer[1] = CLR_GREEN
  
  
  for i = 1, #VOLUME, 1 do
    if i ~= 1 and CLOSE[i] > OPEN[i] then
      colorbuffer[i] = CLR_GREEN
    else
      colorbuffer[i] = CLR_RED
    end
  end

end





