SEPARATEWINDOW=false
INPUTS={ Period={10,2,99,1},
        FastEMA={2,2,99,1},
        SlowEMA={30,2,99,1},
        ApplyTo={1,0,6,1}}
OUTPUTS={ AdaptiveMA={DRAW_LINE,CLR_GREEN,SHIFT_NONE}}
DESCRIPTION="Adaptive Moving Average - ApplyTo can be CLOSE=0 OPEN=1 HIGH=2 LOW=3 MEDIAN=4 TYPICAL=5 WEIGHTED=6"

function calc()
  AdaptiveMA=AMA(ApplyTo,Period,FastEMA,SlowEMA)
end





