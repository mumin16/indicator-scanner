SEPARATEWINDOW=false
INPUTS={ Period={14,2,500,1},
        ApplyTo={0,0,6,1}}
OUTPUTS={ SimpleMA={DRAW_LINE,CLR_GREEN,SHIFT_NONE}}

DESCRIPTION="Simple Moving Average - ApplyTo can be CLOSE=0 OPEN=1 HIGH=2 LOW=3 MEDIAN=4 TYPICAL=5 WEIGHTED=6"

function calc()
  SimpleMA=SMA(ApplyTo,Period) 
end







