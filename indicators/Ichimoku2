SEPARATEWINDOW=false
INPUTS={ ConversionLinePeriod={9,2,100,1},BaseLinePeriod={26,2,260,1},SpanBPeriod={52,2,520,1}}
OUTPUTS={ SpanA={DRAW_LINE,CLR_BROWN,SHIFT_NONE}
,SpanB={DRAW_LINE,CLR_LAVENDER,SHIFT_NONE}
,Cloud={DRAW_TRIANGLESTRIP,"CloudColorBuffer",SHIFT_NONE}

}
DESCRIPTION="Ichimoku Kinko Hyo"

  local function iHighest(StartPos, Depth)
    local res = HIGH[StartPos];
    for i = StartPos - Depth + 1, StartPos, 1 do
      if (HIGH[i] > res) then
        res = HIGH[i];
      end
    end
    return (res);
  end
  local function iLowest(StartPos, Depth)
    local res = LOW[StartPos];
    for i = StartPos - Depth + 1, StartPos, 1 do
      if (LOW[i] < res) then
        res = LOW[i];
      end
    end
    return (res);
  end

function calc()
-- indicator buffers
SpanA={}  SpanB={} 
Cloud={} CloudColorBuffer={}

--Conversion Line (CL, “tenkan sen”) = (9-PH+9-PL) / 2
--Base Line (BL, “kijun sen”) = (26-PH + 26-PL) / 2
--Leading Span A (LSA, “senkou span A”) = (CL + Base Line) / 2
--Leading Span B (LSB, “senkou span B”) = (52-PH + 52-PL) /2

   for i=SpanBPeriod, #CLOSE,1 do
	local cl=(iHighest(i,ConversionLinePeriod)+iLowest(i,ConversionLinePeriod))/2
	local bl=(iHighest(i,BaseLinePeriod)+iLowest(i,BaseLinePeriod))/2
	 SpanA[i-SpanBPeriod+1]=(cl+bl)/2
	 SpanB[i-SpanBPeriod+1]=(iHighest(i,SpanBPeriod)+iLowest(i,SpanBPeriod))/2
    if SpanB[i-SpanBPeriod+1] < SpanA[i-SpanBPeriod+1] then
 
	table.insert(CloudColorBuffer, CLR_GREEN)
	table.insert(CloudColorBuffer, CLR_GREEN)


	



    else
  
	table.insert(CloudColorBuffer, CLR_RED)
	table.insert(CloudColorBuffer, CLR_RED)


	

 

    end

table.insert(Cloud, SpanA[i-SpanBPeriod+1])
table.insert(Cloud, SpanB[i-SpanBPeriod+1])


   end
     
end
    

    





   

   