local map = {
    [0] = sma,        [1] = ema,        [2] = wilder,     [3] = lwma,
    [4] = sinewma,    [5] = trima,      [6] = lsma,       [7] = smma,
    [8] = hma,        [9] = zerolagema, [10] = dema,      [11] = t3_basic,
    [12] = itrend,    [13] = median,    [14] = geomean,   [15] = rema,
    [16] = ilrs,      [17] = ie_2,      [18] = trimagen,  [19] = vwma,
    [20] = jsmooth,   [21] = sma_eq,    [22] = alma,      [23] = tema,
    [24] = t3,        [25] = laguerre,  [26] = md,        [27] = bf2p,
    [28] = bf3p,      [29] = supersmu,  [30] = decycler,  [31] = evwma,
    [32] = ewma,      [33] = dsema,     [34] = tsema,     [35] = vema,
}

-- Dispatch local function to execute moving average by ID
local function AllAvarages(type_id, prices, period, volume)
    local func = map[type_id]
    if not func then error("Invalid Moving Average ID: " .. tostring(type_id)) end
    
    -- Routing for volume-based moving averages
    if type_id == 19 or type_id == 31 or type_id == 35 then
        return func(prices, volume, period)
    else
        return func(prices, period)
    end
end

local function resolve_source(source)
  if type(source) == "number" then
    if source == 0 then
      return CLOSE
    elseif source == 1 then
      return OPEN
    elseif source == 2 then
      return HIGH
    elseif source == 3 then
      return LOW
    elseif source == 4 then
      return MEDIAN
    elseif source == 5 then
      return TYPICAL
    elseif source == 6 then
      return WEIGHTED
    end
  end
  return source
end

function CALC()
 local prices=resolve_source(IN.ApplyTo)
  OUT.Ma = AllAvarages(IN.MaMode,prices, IN.Period, VOLUME)
  OUT.Color={}
  if #OUT.Ma >1 then 
  OUT.Color[1]=CLR_RED
  for i=2,  #OUT.Ma do
    if OUT.Ma[i]>=OUT.Ma[i-1] then  OUT.Color[i]=CLR_GREEN else OUT.Color[i]=CLR_RED end   
  end
  end
end

