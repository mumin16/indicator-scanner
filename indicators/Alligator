SEPARATEWINDOW=false
INPUTS={ JawsPeriod={13,2,99,1},
         JawsShift={8,2,99,1},
         TeethPeriod={8,2,99,1},
         TeethShift={5,2,99,1},
         LipsPeriod={5,2,99,1},
         LipsShift={3,2,99,1},
         MaType={2,0,3,1},
         PriceType={4,0,6,1}}
OUTPUTS={ Jaws={DRAW_LINE,CLR_BLUE,8},
	Teeth={DRAW_LINE,CLR_RED,5},
	Lips={DRAW_LINE,CLR_GREEN,3}}

DESCRIPTION="PriceType can be CLOSE=0 OPEN=1 HIGH=2 LOW=3 MEDIAN=4 TYPICAL=5 WEIGHTED=6 - MaType can be sma=0 ema=1 smma=2 lwma=3"

function calc()
if MaType==0 then
	Jaws=SMA(PriceType,JawsPeriod)
	Teeth=SMA(PriceType,TeethPeriod)
	Lips=SMA(PriceType,LipsPeriod)
end	

if MaType==1 then
	Jaws=EMA(PriceType,JawsPeriod)
	Teeth=EMA(PriceType,TeethPeriod)
	Lips=EMA(PriceType,LipsPeriod)
end

if MaType==2 then
	Jaws=SMMA(PriceType,JawsPeriod)
	Teeth=SMMA(PriceType,TeethPeriod)
	Lips=SMMA(PriceType,LipsPeriod)
end

if MaType==3 then
	Jaws=LWMA(PriceType,JawsPeriod)
	Teeth=LWMA(PriceType,TeethPeriod)
	Lips=LWMA(PriceType,LipsPeriod)
end
end





