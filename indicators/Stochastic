SEPARATEWINDOW=true
INPUTS={ KPeriod={10,2,99,1},
        DPeriod={6,2,99,1},
        Slowing={6,2,99,1},
        MaType={1,0,3,1}}
OUTPUTS={ Stoch={DRAW_LINE,CLR_GREEN,SHIFT_NONE},
	      StochSignal={DRAW_DASHEDLINE,CLR_RED,SHIFT_NONE}}
LEVELS={20,80}
DESCRIPTION="MaType can be Sma=0 Ema=1 Smma=2 Lwma=3"

function calc()
  Stoch=STOCHASTIC(KPeriod,Slowing)
  StochSignal=STOCHASTICSIGNAL(KPeriod,DPeriod,Slowing,MaType)
end





