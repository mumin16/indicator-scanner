IN={ KPeriod=10,
        Slowing=6}
OUT={ BuySignalAgo=-1}
DESCRIPTION="Stochastic Buy Signal Scan"

function calc()
local st=STOCHASTIC(IN.KPeriod,IN.Slowing)
local diff=#CLOSE-#st



  for i = #st, #st-4, -1 do
	if st[i]>20 and st[i-1]<20 then 
		OUT.BuySignalAgo=#CLOSE-i-diff
		break
	else
		OUT.BuySignalAgo=-1
	end
  end


if OUT.BuySignalAgo==-1  then
	return DISCARD_RETURN
	else
	   return OK_RETURN
	end
end