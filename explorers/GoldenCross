


IN={ FastPeriod=50,SlowPeriod=200}
OUT={ BuySignalAgo=-1}
DESCRIPTION="Golden Cross 50ma > 200ma cross scan"

function calc()

  local fastSMA=SMA(MODE_SMA,IN.FastPeriod) 
  local slowSMA=SMA(MODE_SMA,IN.SlowPeriod) 

if #fastSMA<5 or #slowSMA<5 then return DISCARD_RETURN end


  for i = 0, 4, 1 do
	if (fastSMA[#fastSMA-i] > slowSMA[#slowSMA-i]) and (fastSMA[#fastSMA-i-1] < slowSMA[#slowSMA-i-1])  then 
		OUT.BuySignalAgo=i
		break
	else
		OUT.BuySignalAgo=-1
		
	end


  end



if OUT.BuySignalAgo==-1 then	return DISCARD_RETURN	else   return OK_RETURN	end


end

