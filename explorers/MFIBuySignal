INPUTS={ Period={14,2,99,1}}
OUTPUTS={ BuySignalAgo={DRAW_NONE,"Color",SHIFT_NONE}}
DESCRIPTION="Money Flow Index Signal Scan"

function calc()
  local st=MFI(Period)
local diff=#CLOSE-#st

BuySignalAgo={}
Color={}


  for i = #st, #st-10, -1 do
	if st[i]>20 and st[i-1]< 20 then 
		BuySignalAgo[1]=#CLOSE-i-diff
		break
	else
		BuySignalAgo[1]=-1
	end
  end


if BuySignalAgo[1]==0 then Color[1]=CLR_GREEN  else Color[1]=CLR_RED end
if BuySignalAgo[1]==-1  then
	return DISCARD_RETURN
	else
	   return OK_RETURN
	end
end