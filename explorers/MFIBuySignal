IN = { Period = 14 }
SIGNAL = { BuySignalAgo = -1 }
NOTE = "Money Flow Index Signal Scan"

function CALC()
	local st = MFI(IN.Period)
	if #st < 6 then return DISCARD_RETURN end
	local diff = #CLOSE - #st

	for i = #st, #st - 4, -1 do
		if st[i] > 20 and st[i - 1] < 20 then
			SIGNAL.BuySignalAgo = #CLOSE - i - diff
			break
		else
			SIGNAL.BuySignalAgo = -1
		end
	end

	if SIGNAL.BuySignalAgo == -1 then
		return DISCARD_RETURN
	else
		return OK_RETURN
	end
end
