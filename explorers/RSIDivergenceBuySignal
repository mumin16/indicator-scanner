IN={Period=9}
OUT={ BuySignalAgo=-1}
DESCRIPTION="RSI Divergence Buy Signal Scan"

function calc()
  local z=ZIGZAG(IN.Period,5,3)
  local rsi=RSI(CLOSE,IN.Period)


  local lpos={}
  
for i=1,#z,1 do
  if z[i]>0 and z[i]==LOW[i] then
    table.insert(lpos,i)
  end
end



  for j=#lpos,2,-1 do
    
    local Rsimn1=math.min(rsi[lpos[j]-3] ,rsi[lpos[j]-2],rsi[lpos[j]-1],rsi[lpos[j]])
    local Rsimn2=math.min(rsi[lpos[j-1]-3] ,rsi[lpos[j-1]-2],rsi[lpos[j-1]-1],rsi[lpos[j-1]])
    
  if lpos[j]-lpos[j-1]<=30 and ((LOW[lpos[j]]>LOW[lpos[j-1]] and Rsimn1<Rsimn2) or (LOW[lpos[j]]<LOW[lpos[j-1]] and Rsimn1>Rsimn2))  then 
  if    math.abs(LOW[lpos[j]]-LOW[lpos[j-1]])/LOW[lpos[j]]>=0.0618   and math.abs(Rsimn1-Rsimn2)/Rsimn1>=0.0618
  then
  OUT.BuySignalAgo=#LOW-lpos[j]
  break
  end
  end
  end
  
  
   



if OUT.BuySignalAgo==-1 or OUT.BuySignalAgo>5 then
	return DISCARD_RETURN
	else
	   return OK_RETURN
	end
end