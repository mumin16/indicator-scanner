
IN={ Period=14,
        PriceType=0}
OUT={ BuySignalAgo=-1}

DESCRIPTION="Relative Strength Index Signal Scan, PriceType can be CLOSE=0 OPEN=1 HIGH=2 LOW=3 MEDIAN=4 TYPICAL=5 WEIGHTED=6"

function calc()
local st=RSI(IN.PriceType,IN.Period)
if #st<5 then return DISCARD_RETURN end 
local diff=#CLOSE-#st



  for i = #st, #st-4, -1 do
	if st[i]>30 and st[i-1]< 30 then 
		OUT.BuySignalAgo=#CLOSE-i-diff
		break
	else
		OUT.BuySignalAgo=-1
	end
  end



if OUT.BuySignalAgo==-1  then
	return DISCARD_RETURN
	else
	   return OK_RETURN
	end
end

