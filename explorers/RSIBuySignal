IN = {
	Period = 14,
	PriceType = 0
}
SIGNAL = { BuySignalAgo = -1 }

NOTE = "Relative Strength Index Signal Scan, PriceType can be CLOSE=0 OPEN=1 HIGH=2 LOW=3 MEDIAN=4 TYPICAL=5 WEIGHTED=6"

function CALC()
	local st = RSI(IN.PriceType, IN.Period)
	if #st < 5 then return DISCARD_RETURN end
	local diff = #CLOSE - #st


	for i = #st, #st - 4, -1 do
		if st[i] > 30 and st[i - 1] < 30 then
			SIGNAL.BuySignalAgo = #CLOSE - i - diff
			break
		else
			SIGNAL.BuySignalAgo = -1
		end
	end


	if SIGNAL.BuySignalAgo == -1 then
		return DISCARD_RETURN
	else
		return OK_RETURN
	end
end
