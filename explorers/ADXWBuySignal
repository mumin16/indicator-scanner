IN = { Period = 14 }
SIGNAL = { BuySignalAgo = -1 }
NOTE = "ADX Wilder Signal Scan"

function CALC()
	local _, Pdi ,Mdi= ADXW(IN.Period)


	for i = #CLOSE, #CLOSE - 2, -1 do
		if Pdi[i] > Mdi[i] and Pdi[i - 1] < Mdi[i - 1] and Pdi[#CLOSE] > Mdi[#CLOSE] then
			SIGNAL.BuySignalAgo = #CLOSE - i
			break
		else
			SIGNAL.BuySignalAgo = -1
		end
	end

	if SIGNAL.BuySignalAgo == -1 then
		return DISCARD_RETURN
	else
		return OK_RETURN
	end
end
