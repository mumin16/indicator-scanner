IN = { SarStep = 0.002, SarMaximum = 0.02 }
SIGNAL = { BuySignalAgo = -1 }
NOTE = "Parabolic Sar Buy Signal Scan"

function CALC()
	local psar = PSAR(IN.SarStep, IN.SarMaximum)
	if #psar < 3 then return DISCARD_RETURN end


	for i = #psar, #psar - 2, -1 do
		if CLOSE[i] > psar[i] and CLOSE[i - 1] < psar[i - 1] then
			SIGNAL.BuySignalAgo = #CLOSE - i
			break
		else
			SIGNAL.BuySignalAgo = -1
		end
	end


	if SIGNAL.BuySignalAgo == -1 then
		return DISCARD_RETURN
	else
		return OK_RETURN
	end
end
