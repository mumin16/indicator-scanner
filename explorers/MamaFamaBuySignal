IN={FastLimit=0.5,
        SlowLimit=0.05}
OUT={ BuySignalAgo=-1}

DESCRIPTION="Mama Fama Buy Signal Scan"

function calc()
local Mama,Fama=MamaFamaOsc(MEDIAN,IN.FastLimit,IN.SlowLimit)


local diff=#CLOSE-#Mama


  for i = #Mama, #Mama-2, -1 do
	if Mama[i+diff]>Fama[i] and Mama[i+diff-1]<Fama[i-1] then 
		OUT.BuySignalAgo=#CLOSE-i-diff
		break

	else
		OUT.BuySignalAgo=-1
	end
  end



if OUT.BuySignalAgo==-1  then
	return DISCARD_RETURN
	else
	   return OK_RETURN
	end
end