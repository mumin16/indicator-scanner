IN={Period=5,Multiplier=2}
OUT={ BuySignalAgo=-1}
DESCRIPTION="SuperTrend Buy Signal Scan"

function calc()
local st,clr=SUPERTREND(IN.Period, IN.Multiplier)
local diff=#CLOSE-#st



  for i = #st, #st-2, -1 do
	if CLOSE[i+diff]>st[i] and CLOSE[i+diff-1]<st[i-1] then 
		OUT.BuySignalAgo=#CLOSE-i-diff
		break
	else
		OUT.BuySignalAgo=-1
	end
  end



if OUT.BuySignalAgo==-1  then
	return DISCARD_RETURN
	else
	   return OK_RETURN
	end
end