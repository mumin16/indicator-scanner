
IN={Length=20,SignalLength=10}
OUT={ BuySignalAgo=-1}
DESCRIPTION="Andenan Oscillator Buy Signal Scan"

function calc()
local Bull,Bear,Signal=AndeanOsc(IN.Length,IN.SignalLength)

local diff=#CLOSE-#Bull



  for i = #Bull, #Bull-2, -1 do
	if (Bull[i]>Bear[i] and Bull[i-1]<Bear[i-1]) or (Bull[i]>Signal[i] and Bull[i-1]<Signal[i-1]) then 
		OUT.BuySignalAgo=#CLOSE-i-diff
		break
	else
		OUT.BuySignalAgo=-1
	end
  end



if OUT.BuySignalAgo==-1  then
	return DISCARD_RETURN
	else
	   return OK_RETURN
	end
end

DEBUG_RUN("./debug_data",calc)