INPUTS={Length={50,5,100,5},
        SignalLength={9,3,99,3}}
OUTPUTS={ BuySignalAgo={DRAW_NONE,"Color",SHIFT_NONE}}
DESCRIPTION="Andenan Oscillator Buy Signal Scan"

function calc()
local Bull,Bear,Signal=AndeanOsc(Length,SignalLength)

local diff=#CLOSE-#Bull

BuySignalAgo={}
Color={}

  for i = #Bull, #Bull-10, -1 do
	if Bull[i+diff]>Bear[i] and Bull[i+diff-1]<Bear[i-1] then 
		BuySignalAgo[1]=#CLOSE-i-diff
		break

	elseif Bull[i+diff]>Signal[i] and Bull[i+diff-1]<Signal[i-1] then
		BuySignalAgo[1]=#CLOSE-i-diff
		break
	else
		BuySignalAgo[1]=-1
	end
  end


if BuySignalAgo[1]==0 then Color[1]=CLR_GREEN else Color[1]=CLR_RED end
if BuySignalAgo[1]==-1  then
	return DISCARD_RETURN
	else
	   return OK_RETURN
	end
end