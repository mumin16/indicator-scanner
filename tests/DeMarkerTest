OPT = { Period = { min = 7, max = 49, step = 7 } }

REPORT = {}

NOTE = "Demarker Test\nCondition: BuySell(Demarker<>0.3,0.7)"

function CALC()
  for opt1 = OPT.Period.min, OPT.Period.max, OPT.Period.step do
    local Demarker = DEMARKER(opt1)


    local diff = #CLOSE - #Demarker

    local BuySignals = {}
    local SellSignals = {}
    for i = 2, #Demarker, 1 do
      if (Demarker[i] > 0.30 and Demarker[i - 1] < 0.30) or (Demarker[i] > 0.70 and Demarker[i - 1] < 0.70) then table
            .insert(BuySignals, i + diff) end
      if (Demarker[i] < 0.30 and Demarker[i - 1] > 0.30) or (Demarker[i] < 0.70 and Demarker[i - 1] > 0.70) then table
            .insert(SellSignals, i + diff) end
    end



    table.insert(REPORT, CreateTestReport(BuySignals, SellSignals, { Period = opt1 }))
  end
end
