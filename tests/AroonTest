

IN={ Period_opt1={min=7,max=49,step=7}}
        
OUT={ REPORTS={}}
        
DESCRIPTION="Aroon Test"

function calc()


  for opt1=IN.Period_opt1.min, IN.Period_opt1.max, IN.Period_opt1.step do 
     
 
  local AroonUp,AroonDown=AROON(opt1)
  local diff=#CLOSE-#AroonUp
    
    local BuySignals={}
    local SellSignals={}
     for i = 2, #AroonUp, 1 do
        if AroonUp[i] > AroonDown[i] and AroonUp[i - 1] < AroonDown[i  - 1] then table.insert(BuySignals, i+diff)  end
        if AroonUp[i] < AroonDown[i] and AroonUp[i - 1] > AroonDown[i  - 1] then table.insert(SellSignals, i+diff)  end
     end
      

    
    local report=CreateTestReport(BuySignals,SellSignals,opt1)
    table.insert(OUT.REPORTS,report)
    
  
   
  end
  
  return OK_RETURN
  
end