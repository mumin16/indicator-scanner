OPT = { SarStep = { min = 0.002, max = 0.02, step = 0.002 }, SarMaximum = { min = 0.02, max = 0.2, step = 0.02 } }

REPORT = {}

NOTE = "Parabolic Sar Test\nCondition: BuySell(SAR<>CLOSE)"

function CALC()
  for opt1 = OPT.SarStep.min, OPT.SarStep.max, OPT.SarStep.step do
    for opt2 = OPT.SarMaximum.min, OPT.SarMaximum.max, OPT.SarMaximum.step do
      local psar = PSAR(opt1, opt2)


      local BuySignals = {}
      local SellSignals = {}
      for i = 2, #CLOSE, 1 do
        if CLOSE[i] > psar[i] and CLOSE[i - 1] < psar[i - 1] then table.insert(BuySignals, i) end
        if CLOSE[i] < psar[i] and CLOSE[i - 1] > psar[i - 1] then table.insert(SellSignals, i) end
      end




      table.insert(REPORT, CreateTestReport(BuySignals, SellSignals, { SarStep = opt1, SarMaximum = opt2 }))
    end
  end
end
