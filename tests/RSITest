OPT = { Period = { min = 7, max = 49, step = 7 } }

REPORT = {}

NOTE = "RSI Test\nCondition: BuySell(RSI<>30,70)"

function CALC()
  for opt1 = OPT.Period.min, OPT.Period.max, OPT.Period.step do
    local Rsi = RSI(CLOSE, opt1)

    local diff = #CLOSE - #Rsi

    local BuySignals = {}
    local SellSignals = {}
    for i = 2, #Rsi, 1 do
      if (Rsi[i] > 30 and Rsi[i - 1] < 30) or (Rsi[i] > 70 and Rsi[i - 1] < 70) then table.insert(BuySignals, i + diff) end
      if (Rsi[i] < 30 and Rsi[i - 1] > 30) or (Rsi[i] < 70 and Rsi[i - 1] > 70) then table.insert(SellSignals, i + diff) end
    end




    table.insert(REPORT, CreateTestReport(BuySignals, SellSignals, { Period = opt1 }))
  end
end
