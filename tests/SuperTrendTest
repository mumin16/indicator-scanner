OPT = { Period = { min = 5, max = 25, step = 5 }, Multiplier = { min = 1, max = 3, step = 1 } }

REPORT = {}

NOTE = "SuperTrend Test\nCondition: BuySell(SuperTrend<>CLOSE)"

function CALC()
  for opt1 = OPT.Period.min, OPT.Period.max, OPT.Period.step do
    for opt2 = OPT.Multiplier.min, OPT.Multiplier.max, OPT.Multiplier.step do
      local SuperTrend = SUPERTREND(opt1, opt2)


      local BuySignals = {}
      local SellSignals = {}
      for i = 2, #CLOSE, 1 do
        if CLOSE[i] > SuperTrend[i] and CLOSE[i - 1] < SuperTrend[i - 1] then table.insert(BuySignals, i) end
        if CLOSE[i] < SuperTrend[i] and CLOSE[i - 1] > SuperTrend[i - 1] then table.insert(SellSignals, i) end
      end




      table.insert(REPORT, CreateTestReport(BuySignals, SellSignals, { Period = opt1, Multiplier = opt2 }))
    end
  end
end
